# =============================================================================
# ZOUHRI FRAGRANCE - Variables d'environnement
# Copier ce fichier vers .env.local et renseigner les valeurs reelles.
# Ne JAMAIS committer .env.local ni de cle service_role.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obligatoire)
# -----------------------------------------------------------------------------
# URL du projet Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Cle publique anon (safe cote navigateur, protegee par les politiques RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle service_role : STRICTEMENT SERVEUR. Ne jamais exposer au navigateur.
# Utilisee uniquement par des scripts d'administration (seed, creation admin).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site (obligatoire)
# -----------------------------------------------------------------------------
# URL publique du site, utilisee pour les metadonnees, sitemap et Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Boutique - valeurs par defaut (peuvent etre surchargees par parametres_boutique)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEVISE=MAD
NEXT_PUBLIC_FRAIS_LIVRAISON=30
NEXT_PUBLIC_SEUIL_LIVRAISON_GRATUITE=500
# Numero WhatsApp professionnel au format international sans "+" (ex: 2126XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMERO=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Bonjour ZOUHRI FRAGRANCE, je souhaite des informations.

# -----------------------------------------------------------------------------
# Fonctionnalites
# -----------------------------------------------------------------------------
# Active la livraison avec paiement a reception (true/false)
NEXT_PUBLIC_PAIEMENT_A_RECEPTION=true
# Duree de reservation du stock en heures avant liberation manuelle
STOCK_RESERVATION_HEURES=48

# -----------------------------------------------------------------------------
# Developpement uniquement
# -----------------------------------------------------------------------------
# Quand la base Supabase n'est pas configuree, l'application affiche des
# donnees de demonstration clairement identifiees. Valeur: "1" pour activer.
NEXT_PUBLIC_DEMO_MODE=0
